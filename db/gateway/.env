# Copy this file to .env and fill in real values before running
# docker compose up -d.

MYSQL_ROOT_PASSWORD=08132288987
MYSQL_DATABASE=glm_pipeline
MYSQL_USER=glm_user
MYSQL_PASSWORD=08132288987

# --- Which model every command uses by default (override per-call with
# `docker compose exec -e MODEL_NAME=... -e OLLAMA_HOST=... gateway ...`
# for a one-off comparison without changing this default).
#
# Containerized GLM (default):
#MODEL_NAME=glm-film-director
#OLLAMA_HOST=ollama:11434
#
# A host-native model instead (e.g. Qwen pulled with native `ollama pull`,
# not inside the container) — uncomment and adjust:
MODEL_NAME=film-director-qwen
OLLAMA_HOST=host.docker.internal:11434

# --- Host-side paths (used only by docker-compose.yml to set up volume
# mounts — these are Windows paths on YOUR machine, not paths inside any
# container). Use double backslashes or forward slashes, both work with
# Docker Desktop on Windows.

# Your EXISTING native Ollama model store — reusing this avoids
# re-downloading glm-4.7-flash and anything else you've already pulled.
# Typically: C:\Users\YourName\.ollama
# STOP the native Windows Ollama app before starting the container, so
# both don't write to this folder at the same time.
OLLAMA_MODELS_PATH=C:\Users\studi\.ollama

# Where project folders get created (mounted into the gateway container
# at /ai_movies, but you'll browse it at this Windows path in Explorer).
PROJECTS_BASE_PATH_HOST=D:\AI_Movies
